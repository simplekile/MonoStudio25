# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo

# Temporary files
*.tmp
*.bak
*.old
*~
*.swp
*.swo

# Logs
*.log
startup_debug.log
*.log.*

# IDEs
.vscode/
.idea/
*.code-workspace
.cursor/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project specific
# Debug and test files (keep test_demo/ for development but ignore debug ones)
**/debug_*.py
**/test_*_debug.py
**/test_*_position_debug.py

# Analysis and migration scripts (internal tools)
python/analysis/
python/migration/

# Utilities - Development tools (ignore, keep legacy if needed)
python/utilities/update_version.py
python/utilities/cleanup_before_publish.py
python/utilities/replace_prints.py
python/utilities/mono_startup.py
python/utilities/uiready.py
# Note: Mono_MaterialLoader.py kept as legacy (may be needed)

# Test files in testing folder (internal development only)
python/testing/*.py
!python/testing/__init__.py

# Documentation that's auto-generated or temporary
docs/*_SUCCESS_*.md
docs/CLEANUP_BEFORE_PUBLISH.md

# Shelf files - Experimental/Test versions (keep only MonoStudio.shelf, MonoStudioAdvanced.shelf)
shelves/*_Test*.shelf
shelves/*_Fixed*.shelf
shelves/*_Alternative*.shelf
shelves/*_Real*.shelf
shelves/*_XML*.shelf
shelves/*_experimental*.shelf
shelves/*_backup*.shelf
shelves/*_old*.shelf

# Quick test files (temporary)
**/quick_test_*.py
**/temp_*.py
**/scratch_*.py
**/experiment_*.py
**/experimental_*.py

# Backup and old versions
**/*_backup.*
**/*_old.*
**/*_v[0-9]*_backup.*
**/*_copy.*
**/*_duplicate.*

# Temporary analysis/output files
**/output_*.txt
**/result_*.json
**/analysis_output.*

